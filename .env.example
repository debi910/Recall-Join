# Server scripts (npm run setup / import:nsq). Never commit the real .env.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=recall
DEMO_PASSWORD=
DEMO_SHOP_TEAM=shop-demo
DEMO_DIST_TEAM=dist-demo
ADMIN_TEAM=admins

# Web app (Vite exposes only VITE_* to the browser)
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DB_ID=recall
VITE_APPWRITE_FUNCTION_ID=recall-join
